rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get("admin", false) == true ||
        request.auth.token.get("email", "") == "gnavsih1@gmail.com" ||
        request.auth.token.get("email", "") == "admin@canteen375.com" ||
        request.auth.token.get("email", "") == "siti@canteen375.com" ||
        request.auth.token.get("email", "") == "amalia@canteen375.com" ||
        request.auth.token.get("email", "") == "eka@canteen375.com" ||
        request.auth.token.get("email", "") == "widya@canteen375.com"
      );
    }

    // POS checkout uses the administrator account today.  A dedicated POS
    // cashier can be granted the explicit posOperator custom claim later;
    // ordinary authenticated members must not mutate financial or loyalty
    // materialized data.
    function isPosOperator() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.get("posOperator", false) == true
      );
    }

    function validVoucherProgramCounters() {
      return request.resource.data.status in ["active", "paid", "closed"] &&
        request.resource.data.totalRedeemed is int &&
        request.resource.data.totalRedeemed >= 0 &&
        request.resource.data.totalSettled is int &&
        request.resource.data.totalSettled >= 0 &&
        request.resource.data.totalSettled <= request.resource.data.totalRedeemed;
    }

    function validVoucherProgramCountersForUpdate() {
      return request.resource.data.status in ["active", "paid", "closed"] &&
        (!request.resource.data.keys().hasAny(["totalRedeemed"]) ||
          (request.resource.data.totalRedeemed is int && request.resource.data.totalRedeemed >= 0)) &&
        (!request.resource.data.keys().hasAny(["totalSettled"]) ||
          (request.resource.data.totalSettled is int && request.resource.data.totalSettled >= 0)) &&
        (!request.resource.data.keys().hasAll(["totalRedeemed", "totalSettled"]) ||
          request.resource.data.totalSettled <= request.resource.data.totalRedeemed);
    }

    function validVoucherProgramFields() {
      return request.resource.data.programName is string &&
        request.resource.data.programName.size() > 0 &&
        request.resource.data.institutionName is string &&
        request.resource.data.institutionName.size() > 0 &&
        request.resource.data.defaultNominal is int &&
        request.resource.data.defaultNominal >= 0 &&
        request.resource.data.revision is int &&
        request.resource.data.revision >= 0;
    }

    function validVoucherProgramFieldsForUpdate() {
      return (!request.resource.data.keys().hasAny(["programName"]) ||
          (request.resource.data.programName is string && request.resource.data.programName.size() > 0)) &&
        (!request.resource.data.keys().hasAny(["institutionName"]) ||
          (request.resource.data.institutionName is string && request.resource.data.institutionName.size() > 0)) &&
        (!request.resource.data.keys().hasAny(["defaultNominal"]) ||
          (request.resource.data.defaultNominal is int && request.resource.data.defaultNominal >= 0)) &&
        (!request.resource.data.keys().hasAny(["revision"]) ||
          (request.resource.data.revision is int && request.resource.data.revision >= 0));
    }

    function validVoucherProgramCreate() {
      return validVoucherProgramCounters() &&
        request.resource.data.status == "active" &&
        validVoucherProgramFields();
    }

    // Members doc id may be custom (fullName_phone); field uid == Firebase Auth UID.
    function isMemberProfileOwner() {
      return isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // userId / memberId on vouchers, feedbacks, orders may be Auth UID (legacy) or Members document id.
    function memberIdRefersToAuthUser(memberDocId) {
      return memberDocId == request.auth.uid ||
        (exists(/databases/$(database)/documents/Members/$(memberDocId)) &&
          get(/databases/$(database)/documents/Members/$(memberDocId)).data.uid == request.auth.uid) ||
        (exists(/databases/$(database)/documents/zTesting_Members/$(memberDocId)) &&
          get(/databases/$(database)/documents/zTesting_Members/$(memberDocId)).data.uid == request.auth.uid);
    }

    function memberProfileFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "fullName", "name", "nama", "phoneNumber", "phone", "email",
        "photoUrl", "address", "updatedAt"
      ]);
    }

    function validMemberPointLedger() {
      return request.resource.data.operationId is string &&
        request.resource.data.operationId.size() > 0 &&
        request.resource.data.eventType in ["earn", "reverse", "manual_adjustment"] &&
        request.resource.data.status in ["completed", "pending"] &&
        request.resource.data.pointsDelta is int &&
        request.resource.data.memberId is string &&
        request.resource.data.memberId.size() > 0;
    }

    function validMemberProgramOperation() {
      return request.resource.data.operationId is string &&
        request.resource.data.operationId.size() > 0 &&
        request.resource.data.status in ["completed", "pending", "skipped"];
    }

    function validMemberCampaign() {
      return request.resource.data.type == "cashbackCampaign" &&
        request.resource.data.status in ["active", "archived"] &&
        request.resource.data.isActive is bool &&
        ((request.resource.data.status == "active" && request.resource.data.isActive == true) ||
          (request.resource.data.status == "archived" && request.resource.data.isActive == false)) &&
        request.resource.data.threshold is int &&
        request.resource.data.threshold > 0 &&
        request.resource.data.value is int &&
        request.resource.data.value > 0 &&
        request.resource.data.transactionRequirement is int &&
        request.resource.data.transactionRequirement >= 0 &&
        request.resource.data.activeDate is timestamp &&
        request.resource.data.expireDate is timestamp &&
        request.resource.data.expireDate >= request.resource.data.activeDate &&
        request.resource.data.totalParticipants is int &&
        request.resource.data.totalParticipants >= 0 &&
        request.resource.data.totalClaimed is int &&
        request.resource.data.totalClaimed >= 0 &&
        request.resource.data.totalClaimed <= request.resource.data.totalParticipants &&
        request.resource.data.totalRedemptions is int &&
        request.resource.data.totalRedemptions >= request.resource.data.totalClaimed;
    }

    function validMemberCampaignForUpdate() {
      return request.resource.data.type == "cashbackCampaign" &&
        (!request.resource.data.keys().hasAny(["status"]) || request.resource.data.status in ["active", "archived"]) &&
        (!request.resource.data.keys().hasAny(["isActive"]) || request.resource.data.isActive is bool) &&
        (!request.resource.data.keys().hasAll(["status", "isActive"]) ||
          (request.resource.data.status == "active" && request.resource.data.isActive == true) ||
          (request.resource.data.status == "archived" && request.resource.data.isActive == false)) &&
        (!request.resource.data.keys().hasAny(["threshold"]) || (request.resource.data.threshold is int && request.resource.data.threshold > 0)) &&
        (!request.resource.data.keys().hasAny(["value"]) || (request.resource.data.value is int && request.resource.data.value > 0)) &&
        (!request.resource.data.keys().hasAny(["transactionRequirement"]) || (request.resource.data.transactionRequirement is int && request.resource.data.transactionRequirement >= 0)) &&
        (!request.resource.data.keys().hasAny(["activeDate"]) || request.resource.data.activeDate is timestamp) &&
        (!request.resource.data.keys().hasAny(["expireDate"]) || request.resource.data.expireDate is timestamp) &&
        (!request.resource.data.keys().hasAll(["activeDate", "expireDate"]) || request.resource.data.expireDate >= request.resource.data.activeDate) &&
        (!request.resource.data.keys().hasAny(["totalParticipants"]) || (request.resource.data.totalParticipants is int && request.resource.data.totalParticipants >= 0)) &&
        (!request.resource.data.keys().hasAny(["totalClaimed"]) || (request.resource.data.totalClaimed is int && request.resource.data.totalClaimed >= 0)) &&
        (!request.resource.data.keys().hasAny(["totalRedemptions"]) || (request.resource.data.totalRedemptions is int && request.resource.data.totalRedemptions >= 0)) &&
        (!request.resource.data.keys().hasAll(["totalParticipants", "totalClaimed"]) || request.resource.data.totalClaimed <= request.resource.data.totalParticipants) &&
        (!request.resource.data.keys().hasAll(["totalRedemptions", "totalClaimed"]) || request.resource.data.totalRedemptions >= request.resource.data.totalClaimed);
    }

    // ── NEW COLLECTIONS FOR POS APP ───────────────────────────────────────────

    match /Categories/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /assets/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /config/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /DailyTransaction/{id} {
      allow read, write: if isAuthenticated();
    }
    match /MonthlyTransaction/{id} {
      allow read, write: if isAuthenticated();
    }
    match /YearlyTransaction/{id} {
      allow read, write: if isAuthenticated();
    }
    match /DailyFinancialReport/{id} {
      allow read, write, update, delete: if true;

      match /Expenses/{expenseId} {
        allow read, write, update, delete: if true;
      }
    }
    match /MonthlyFinancialReport/{id} {
      allow read, write, update, delete: if true;
    }
    match /YearlyFinancialReport/{id} {
      allow read, write, update, delete: if true;
    }
    match /Status/{id} { allow read, write, delete, update: if true; }
    match /Expenses/{id} { allow read, write: if isAuthenticated(); }
    match /CashflowSettings/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /RecentlyServed/{id} { allow read, write, delete, update: if true; }

    // Maps Firebase Auth UID → Members document id (custom id).
    match /MemberLinks/{authUid} {
      allow read: if isAuthenticated() && request.auth.uid == authUid;
      allow create: if isAuthenticated()
                    && request.auth.uid == authUid
                    && request.resource.data.memberDocId is string
                    && request.resource.data.memberDocId.size() > 0;
      allow update, delete: if isAdmin();
    }

    // Members: document id is human-readable; field uid == Firebase Auth UID.
    // Register page checks duplicate via getDoc before sign-up (still anonymous): allow get only if doc is absent so existing profiles stay private.
    match /Members/{memberDocId} {
      allow get: if !exists(/databases/$(database)/documents/Members/$(memberDocId)) || isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == "member";
      allow update: if isAdmin() ||
        (isMemberProfileOwner() && memberProfileFieldsOnly());
      allow delete: if isAdmin();
    }

    // ── VOUCHERS COLLECTIONS ──────────────────────────────────────────────────
    match /voucher/{id} {
      allow read: if isAdmin()
                    || (isAuthenticated() && memberIdRefersToAuthUser(resource.data.userId));
      allow write: if isPosOperator();
    }
    match /vouchers/{id} {
      allow read: if isAdmin()
                    || (isAuthenticated() && memberIdRefersToAuthUser(resource.data.userId));
      allow create, update: if isPosOperator();
      allow delete: if false;
    }

    // ── B2B VOUCHER PROGRAMS ─────────────────────────────────────────────────
    match /voucherPrograms/{id} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && validVoucherProgramCreate();
      allow update: if isPosOperator() && resource.data.status != "closed" &&
        validVoucherProgramCountersForUpdate() && validVoucherProgramFieldsForUpdate();
      allow delete: if isAdmin() && resource.data.status != "closed";
      match /redemptions/{operationId} {
        allow read: if isAuthenticated();
        allow create, update: if isPosOperator() &&
          request.resource.data.operationId == operationId &&
          request.resource.data.status == "completed" &&
          ((request.resource.data.eventType == "redemption" &&
              request.resource.data.amount is int && request.resource.data.amount > 0) ||
            (request.resource.data.eventType == "edit" &&
              request.resource.data.amountDelta is int && request.resource.data.amountDelta != 0));
        allow delete: if false;
      }
      match /settlements/{operationId} {
        allow read: if isAuthenticated();
        allow create, update: if isPosOperator() &&
          request.resource.data.operationId == operationId &&
          request.resource.data.status == "completed" &&
          request.resource.data.amount is int && request.resource.data.amount > 0 &&
          request.resource.data.paymentMethod in ["Cash", "QRIS", "Online"];
        allow delete: if false;
      }
      match /closures/{operationId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() &&
          request.resource.data.operationId == operationId &&
          request.resource.data.status == "completed";
        allow delete: if false;
      }
    }

    // ── VOUCHER GROUP (CAMPAIGNS) ─────────────────────────────────────────────
    match /voucherGroup/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && request.resource.data.voucherGroupId == groupId &&
        validMemberCampaign();
      allow update: if isPosOperator() && request.resource.data.voucherGroupId == groupId &&
        validMemberCampaignForUpdate() &&
        (resource.data.status != "archived" || request.resource.data.status == "archived");
      allow delete: if false;
    }

    // ── COMPETITION RECORDS (LEADERBOARD DATA) ────────────────────────────────
    match /competitionRecords/{monthId} {
      allow read: if isAuthenticated();
      allow create, update: if isPosOperator();
      allow delete: if false;
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create, update: if isPosOperator();
        allow delete: if false;
      }
    }

    match /SelfOrders/{orderId} {
      allow read, write: if true;
    }
    
    // ── TRANSACTION HISTORY (MEMBERS) ─────────────────────────────────────────
    match /pointTransactions/{id} {
      allow read: if isAdmin() ||
        (isAuthenticated() && memberIdRefersToAuthUser(resource.data.memberId));
      allow create: if isPosOperator() && request.resource.data.operationId == id &&
        validMemberPointLedger();
      allow update: if isPosOperator() && resource.data.operationId == id &&
        request.resource.data.operationId == id && validMemberPointLedger();
      allow delete: if false;
    }

    match /memberProgramOperations/{id} {
      allow read: if isAdmin();
      allow create, update: if isPosOperator() && request.resource.data.operationId == id &&
        validMemberProgramOperation();
      allow delete: if false;
    }

    match /competitionPrizes/{periodId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
      match /winners/{winnerId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin();
        allow delete: if false;
      }
    }

    match /externalVoucherClaims/{id} {
      allow read: if isAdmin();
      allow create, update: if isPosOperator() && request.resource.data.operationId == id &&
        request.resource.data.status in ["pending", "failed", "completed"];
      allow delete: if false;
    }
    
    // ── FEEDBACKS ─────────────────────────────────────────────────────────────

    match /feedbacks/{feedbackId} {
      allow create: if isAuthenticated()
                    && memberIdRefersToAuthUser(request.resource.data.memberId);
      allow read: if isAdmin()
                    || (isAuthenticated() && memberIdRefersToAuthUser(resource.data.memberId));
      allow update, delete: if isAdmin();
    }

    // ── CANTEENS (BRANCH DATA) ────────────────────────────────────────────────
    match /Canteens/{canteenId} {

      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
      allow create, delete: if isAdmin();

      match /Inventory/{id} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      match /DailyStockLogs/{id} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      match /MenuCollection/{menuId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /Metadata/{configId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || (isAuthenticated() && configId == 'SelfOrderCounter');
      }

      match /Metadata/Settings {
        allow read: if isAuthenticated();
      }

      match /OptionGroups/{groupId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      match /suppliers/{supplierId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      match /shoppingOrders/{orderId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      match /Status/{orderId} {
        allow read, write, update, delete: if true;
      }

      match /RecentlyServed/{orderId} {
        allow read, write, update, delete: if true;
      }

      match /SelfOrders/{orderId} {
        allow read: if isAdmin()
                      || (isAuthenticated() && memberIdRefersToAuthUser(resource.data.memberId));
        allow create: if isAuthenticated()
                        && memberIdRefersToAuthUser(request.resource.data.memberId);
        allow update, delete: if isAdmin();
      }

      match /OpenBills/{memberId} {
        allow read, write, update, delete: if isAuthenticated();

        match /Orders/{tabOrderId} {
          allow read, write, update, delete: if isAuthenticated();
        }
      }

      match /SettledBills/{billId} {
        allow read, write, update, delete: if isAuthenticated();
      }

      match /Orders/{orderID} {
        allow read, write, update, delete: if isAuthenticated();
      }
    }

    // ── PUBLIC PRODUCTS (OLD VERSION) ─────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products_test/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── TESTING MODE COLLECTIONS (zTesting_ prefix) ──────────────────────────────
    match /zTesting_Categories/{id} {
      allow read, write, update, delete: if true;
    }

    match /zTesting_DailyTransaction/{id} {
      allow read, write, update, delete: if true;
    }

    match /zTesting_MonthlyTransaction/{id} {
      allow read, write, update, delete: if true;
    }

    match /zTesting_YearlyTransaction/{id} {
      allow read, write, update, delete: if true;
    }

    match /zTesting_DailyFinancialReport/{id} {
      allow read, write, update, delete: if true;
      match /Expenses/{expenseId} {
        allow read, write, update, delete: if true;
      }
    }
    
    match /zTesting_MonthlyFinancialReport/{id} {
      allow read, write, update, delete: if true;
    }
    
    match /zTesting_YearlyFinancialReport/{id} {
      allow read, write, update, delete: if true;
    }

    match /zTesting_Expenses/{id} {
      allow read, write: if true;
    }

    match /zTesting_Status/{id} {
      allow read, write, update, delete: if true;
    }

    match /zTesting_RecentlyServed/{id} {
      allow read, write, delete, update: if true;
    }

    match /zTesting_Members/{uid} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.uid == request.auth.uid && memberProfileFieldsOnly());
      allow delete: if isAdmin();
    }

    match /zTesting_CashflowSettings/{id} {
      allow read, write, update, delete: if true;
    }

    match /zTesting_competitionRecords/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isPosOperator();
      allow delete: if false;
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create, update: if isPosOperator();
        allow delete: if false;
      }
    }

    match /zTesting_voucher/{id} {
      allow read: if isAdmin() ||
        (isAuthenticated() && memberIdRefersToAuthUser(resource.data.userId));
      allow write: if isPosOperator();
    }

    match /zTesting_vouchers/{id} {
      allow read: if isAdmin() ||
        (isAuthenticated() && memberIdRefersToAuthUser(resource.data.userId));
      allow create, update: if isPosOperator();
      allow delete: if false;
    }

    match /zTesting_voucherGroup/{id} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && request.resource.data.voucherGroupId == id &&
        validMemberCampaign();
      allow update: if isPosOperator() && request.resource.data.voucherGroupId == id &&
        validMemberCampaignForUpdate() &&
        (resource.data.status != "archived" || request.resource.data.status == "archived");
      allow delete: if false;
    }

    match /zTesting_voucherPrograms/{id} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && validVoucherProgramCreate();
      allow update: if isPosOperator() && resource.data.status != "closed" &&
        validVoucherProgramCountersForUpdate() && validVoucherProgramFieldsForUpdate();
      allow delete: if isAdmin() && resource.data.status != "closed";
      match /redemptions/{operationId} {
        allow read: if isAuthenticated();
        allow create, update: if isPosOperator() &&
          request.resource.data.operationId == operationId &&
          request.resource.data.status == "completed";
        allow delete: if false;
      }
      match /settlements/{operationId} {
        allow read: if isAuthenticated();
        allow create, update: if isPosOperator() &&
          request.resource.data.operationId == operationId &&
          request.resource.data.status == "completed" &&
          request.resource.data.amount is int && request.resource.data.amount > 0 &&
          request.resource.data.paymentMethod in ["Cash", "QRIS", "Online"];
        allow delete: if false;
      }
      match /closures/{operationId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() &&
          request.resource.data.operationId == operationId &&
          request.resource.data.status == "completed";
        allow delete: if false;
      }
    }

    match /zTesting_MemberLinks/{authUid} {
      allow read: if isAuthenticated() && request.auth.uid == authUid;
      allow create: if isAuthenticated() && request.auth.uid == authUid
                    && request.resource.data.memberDocId is string
                    && request.resource.data.memberDocId.size() > 0;
      allow update, delete: if isAdmin();
    }

    match /zTesting_Canteens/{canteenId} {
      allow read, write, update, delete: if true;

      match /{subcollection=**} {
        allow read, write, update, delete: if true;
      }
    }

    match /zTesting_pointTransactions/{id} {
      allow read: if isAdmin() ||
        (isAuthenticated() && memberIdRefersToAuthUser(resource.data.memberId));
      allow create: if isPosOperator() && request.resource.data.operationId == id &&
        validMemberPointLedger();
      allow update: if isPosOperator() && resource.data.operationId == id &&
        request.resource.data.operationId == id && validMemberPointLedger();
      allow delete: if false;
    }

    match /zTesting_memberProgramOperations/{id} {
      allow read: if isAdmin();
      allow create, update: if isPosOperator() && request.resource.data.operationId == id &&
        validMemberProgramOperation();
      allow delete: if false;
    }

    match /zTesting_competitionPrizes/{periodId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
      match /winners/{winnerId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin();
        allow delete: if false;
      }
    }

    match /zTesting_externalVoucherClaims/{id} {
      allow read: if isAdmin();
      allow create, update: if isPosOperator() && request.resource.data.operationId == id &&
        request.resource.data.status in ["pending", "failed", "completed"];
      allow delete: if false;
    }

    match /zTesting_SelfOrders/{id} {
      allow read, write, update, delete: if true;
    }

    match /zTesting_feedbacks/{id} {
      allow read, write, update, delete: if true;
    }

    match /zTesting_assets/{id} {
      allow read, write, update, delete: if true;
    }

    match /zTesting_config/{id} {
      allow read, write, update, delete: if true;
    }
  }
}
